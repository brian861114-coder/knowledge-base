{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Physics Knowledge Map",
  "version": "1.0.0",
  "identifier": "com.brian.physicsknowledgemap",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "Physics Knowledge Map",
        "width": 1600,
        "height": 980,
        "minWidth": 1200,
        "minHeight": 760,
        "backgroundColor": "#f7f4ee"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
